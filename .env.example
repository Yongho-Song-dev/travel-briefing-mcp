# 외교부 공공데이터포털 API 키 (비자 + 여행경보 공통)
# 발급: https://www.data.go.kr → "국가·지역별 입국허가요건" / "국가/지역별 여행경보제도"
MOFA_API_KEY=

# 한국수출입은행 환율 API 키
# 발급: https://www.koreaexim.go.kr → 오픈API → 인증키 신청
KOREAEXIM_API_KEY=

# 네이버 검색 API (블로그 여행후기 검색)
# 발급: https://developers.naver.com → 애플리케이션 등록 → 검색 권한 추가
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 외부 JSON 호스팅 URL 오버라이드 (미설정 시 프로젝트 기본 URL 사용)
# TB_EMBASSY_JSON_URL=https://raw.githubusercontent.com/Yongho-Song-dev/travel-briefing-mcp/main/embassies.json
# TB_DESTINATIONS_JP_URL=https://raw.githubusercontent.com/Yongho-Song-dev/travel-briefing-mcp/main/curation/destinations_jp.json

# 로컬 테스트용 (위 URL 대신 로컬 파일 직접 참조)
# TB_EMBASSY_JSON_URL=file:///home/unix/workspace_with_claude/mcp-server/embassies.json
# TB_DESTINATIONS_JP_URL=file:///home/unix/workspace_with_claude/mcp-server/curation/destinations_jp.json
